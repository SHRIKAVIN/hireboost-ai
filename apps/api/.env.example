# =====================================================
# HireBoost AI — Backend (apps/api)
# =====================================================
# Server-side only. NEVER expose these values to the browser.
# =====================================================

# --- Server ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/hireboost
MONGODB_DB_NAME=hireboost

# --- Web app (used for OAuth redirects + CORS) ---
WEB_APP_URL=http://localhost:5173

# --- Auth (JWT) ---
# Both secrets MUST be at least 16 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-16-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-16-chars
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=hireboost-ai
JWT_AUDIENCE=hireboost-web

# --- Cookies (refresh token) ---
# COOKIE_DOMAIN= leave blank for localhost; set to ".yourdomain.com" in prod
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- Google OAuth ---
# 1. https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth client ID → Web application
# 3. Authorized redirect URI must EXACTLY match GOOGLE_REDIRECT_URI below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
GOOGLE_OAUTH_SUCCESS_PATH=/auth/callback
GOOGLE_OAUTH_FAILURE_PATH=/login

# --- AI providers (Phase 8) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Logging ---
LOG_LEVEL=info
