# =====================================================
# HireBoost AI — Backend (apps/api)
# =====================================================
# Server-side only. NEVER expose these values to the browser.
# =====================================================

# --- Server ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/hireboost
MONGODB_DB_NAME=hireboost

# --- Auth (JWT) ---
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-too-please
JWT_REFRESH_EXPIRES_IN=30d

# --- Google OAuth (Phase 4 scaffold) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# --- AI providers (Phase 8) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Logging ---
LOG_LEVEL=info
