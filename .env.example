# =====================================================
# HireBoost AI — Root example environment file
# =====================================================
# Copy this file to `.env` for shared local defaults.
# Each app (apps/web, apps/api) ALSO has its own
# `.env.example` you should copy to `.env` (or `.env.local`)
# inside that app folder.
#
# DO NOT commit real `.env` files. They are gitignored.
# =====================================================

# -----------------------------
# Shared
# -----------------------------
NODE_ENV=development
APP_NAME=HireBoost AI

# -----------------------------
# Frontend (apps/web) — Vite requires VITE_ prefix
# Duplicate these into apps/web/.env
# -----------------------------
VITE_APP_NAME=HireBoost AI
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_GOOGLE_CLIENT_ID=

# -----------------------------
# Backend (apps/api)
# Duplicate these into apps/api/.env
# -----------------------------
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/hireboost
MONGODB_DB_NAME=hireboost

# Auth
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-too-please
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth (scaffold for Phase 4)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# AI Providers (Phase 8) — Gemini-first, OpenAI swappable
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Logging
LOG_LEVEL=info
